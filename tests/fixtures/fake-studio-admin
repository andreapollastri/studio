#!/usr/bin/env bash
# Stand-in for /usr/local/sbin/studio-admin in the test suite: echoes what it
# was asked, answers like the real helper would.
set -euo pipefail
cmd=${1:-}; shift || true
input=$(cat)
log=${FAKE_STUDIO_ADMIN_LOG:-}
[ -n "$log" ] && printf '%s %s %s\n' "$cmd" "$*" "$input" >> "$log"
case "$cmd" in
  workspace-create)
    handle=$1; slug=$2
    host=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin)["preview_host"])')
    port=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin)["bridge_port"])')
    printf '{"ok":true,"app_url":"https://%s","bridge_url":"http://127.0.0.1:%s","path":"/srv/studio/workspaces/%s/%s"}\n' "$host" "$port" "$handle" "$slug" ;;
  workspace-start|workspace-stop|workspace-delete|workspace-env|workspace-configure|project-configure)
    printf '{"ok":true}\n' ;;
  sandbox-create)
    if [ "${FAKE_SANDBOX_FAIL:-}" = 1 ]; then printf '{"ok":false,"error":"composer install failed: out of memory"}\n'; exit 1; fi
    host=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin)["preview_host"])')
    printf '{"ok":true,"app_url":"https://%s","path":"/srv/studio/workspaces/%s/.sandboxes/%s/c%s"}\n' "$host" "$1" "$2" "$3" ;;
  sandbox-delete)
    printf '{"ok":true}\n' ;;
  claude-logout|claude-forget|cursor-logout|cursor-forget)
    # what the helper said under PHP-FPM's ProtectSystem=full, before Studio's drop-in
    if [ "${FAKE_SIGN_OUT_FAIL:-}" = 1 ]; then
      printf '{"ok":false,"unexpected":true,"error":"studio-admin stopped (exit 1) at: chmod 755 \\"$(dirname \\"$f\\")\\""}\n'
      printf "chmod: changing permissions of '/etc/claude-code': Read-only file system\n" >&2; exit 1
    fi
    printf '{"ok":true}\n' ;;
  person-ensure|git-cli)
    printf '{"ok":true}\n' ;;
  cursor-status)
    if [ "${FAKE_CURSOR_LOGGED_IN:-0}" = 1 ]; then
      printf '{"ok":true,"logged_in":true,"email":"%s"}\n' "${FAKE_CURSOR_EMAIL:-maria@cursor.test}"
    else
      printf '{"ok":true,"logged_in":false,"email":null}\n'
    fi ;;
  claude-status)
    if [ "${FAKE_CLAUDE_METHOD:-none}" = none ]; then
      printf '{"ok":true,"logged_in":false,"auth_method":"none","status":{"authMethod":"none"}}\n'
    else
      printf '{"ok":true,"logged_in":true,"auth_method":"%s","status":{"authMethod":"%s"}}\n' "$FAKE_CLAUDE_METHOD" "$FAKE_CLAUDE_METHOD"
    fi ;;
  workspace-status)
    printf '{"ok":true,"status":"%s"}\n' "${FAKE_STUDIO_ADMIN_STATUS:-running}" ;;
  project-bootstrap)
    printf '{"ok":true,"sha":"b00t5trap"}\n' ;;
  project-create)
    printf '{"ok":true,"larapilot_api_token":"lp-token-%s","sha":"abc1234"}\n' "$1" ;;
  project-deploy)
    printf '{"ok":true,"sha":"def5678"}\n' ;;
  project-delete)
    printf '{"ok":true}\n' ;;
  project-db)
    db="prj_$(printf '%s' "$1" | tr '-' '_')"
    printf '{"ok":true,"database":"%s","username":"%s","password":"site-secret"}\n' "$db" "$db" ;;
  update-check)
    printf '{"ok":true,"channel":"stable","current":"v1.0.0","latest":"%s","target":"%s","update_available":%s,"waiting":"","waiting_reason":""}\n' "${FAKE_STUDIO_LATEST:-v1.1.0}" "${FAKE_STUDIO_LATEST:-v1.1.0}" "${FAKE_STUDIO_AVAILABLE:-true}" ;;
  update-start)
    printf '{"ok":true,"started":true,"unit":"%s"}\n' "$([ "${1:-}" = force ] && echo studio-update-force.service || echo studio-update.service)" ;;
  update-channel)
    printf '{"ok":true,"channel":"%s"}\n' "$1" ;;
  update-auto|system-update-auto)
    printf '{"ok":true,"auto":%s}\n' "$([ "$1" = on ] && echo true || echo false)" ;;
  php-install)
    if [ "${FAKE_PHP_INSTALL_FAIL:-}" = 1 ]; then printf '{"ok":false,"error":"PHP %s could not be installed (see /var/log/studio-install.log)"}\n' "$1"; exit 1; fi
    printf '{"ok":true,"version":"%s"}\n' "$1" ;;
  system-update-start)
    printf '{"ok":true,"started":true,"unit":"studio-system-update.service"}\n' ;;
  fail)
    printf '{"ok":false,"error":"boom"}\n'; exit 1 ;;
  fail-in-subshell)
    # fail() inside $(require_field …), then the helper's own line for the command that stopped it
    printf '{"ok":false,"error":"missing input field: repo_url"}\n{"ok":false,"unexpected":true,"error":"studio-admin stopped (exit 1) at: repo=$(require_field repo_url)"}\n'; exit 1 ;;
  fail-unexpected)
    printf '[studio-admin] cloning https://github.com/acme/shop @ main\nJob for php8.4-fpm.service failed.\n' >&2
    printf '{"ok":false,"unexpected":true,"error":"studio-admin stopped (exit 1) at: systemctl reload \\"php$1-fpm\\""}\n'; exit 1 ;;
  *)
    printf '{"ok":false,"error":"unknown command %s"}\n' "$cmd" >&2; exit 2 ;;
esac
