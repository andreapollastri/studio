# ---------------------------------------------------------------- people ----

# One Linux user per person, ws-<handle>, whose home every workspace of theirs shares: their
# Claude Code login (~/.claude) is there, once for all their projects, readable by them alone.
ensure_person() { # handle
    local user="ws-$1" home="$HOMES/ws-$1"
    id "$user" >/dev/null 2>&1 || useradd --create-home --home-dir "$home" --shell /bin/bash "$user"
    chmod 751 "$home"
    ensure_claude_dir "$1" .claude
    ensure_claude_policy
}

# A person may sign in to several Claude subscriptions: each one is a config directory of its own
# in their home, .claude (the first one, "default") or .claude-<slug>. The login (.credentials.json,
# .claude.json) stays in each; what makes a conversation resumable on any of them (projects/, the
# transcripts `--resume <id>` reads) and what the person set up for all of them (agents, commands,
# skills, plugins, settings) lives in .claude, linked from the others.
valid_claude_dir() { [[ "$1" =~ ^\.claude(-[a-z0-9]{1,40})?$ ]] || fail "invalid Claude directory: $1"; }

# claude_dir_layout HOME DIR — run as the person: their home is theirs to change, and root would
# follow whatever links they put in it. Idempotent; a directory an older layout left in DIR is
# merged into the shared one, a file kept aside as <name>.local when .claude has its own.
claude_dir_layout() {
    local home=${1:?} dir=${2:?} entry path target
    local shared_dirs=(projects todos shell-snapshots agents commands skills plugins) shared_files=(settings.json CLAUDE.md)
    umask 077
    if [ -L "$home/.claude" ]; then rm -f -- "${home:?}/.claude"; fi
    mkdir -p "$home/.claude"; chmod 700 "$home/.claude"
    [ "$dir" != .claude ] || return 0
    if [ -L "$home/$dir" ]; then rm -f -- "${home:?}/${dir:?}"; fi
    mkdir -p "$home/$dir"; chmod 700 "$home/$dir"
    for entry in "${shared_dirs[@]}" "${shared_files[@]}"; do
        path="$home/$dir/$entry"; target="$home/.claude/$entry"
        if [ -L "$path" ]; then
            [ "$(readlink "$path")" != "../.claude/$entry" ] || continue
            rm -f -- "${path:?}"
        fi
        if [[ " ${shared_dirs[*]} " == *" $entry "* ]]; then
            if [ -L "$target" ]; then rm -f -- "${target:?}"; fi
            mkdir -p "$target"
            if [ -d "$path" ]; then
                cp -Rpn "$path/." "$target/" 2>/dev/null || true
                rm -rf -- "${path:?}"
            fi
        fi
        if [ -e "$path" ]; then
            if [ -e "$target" ] || [ -L "$target" ]; then mv -f "$path" "$path.local"; else mv "$path" "$target"; fi
        fi
        ln -sfn "../.claude/$entry" "$path"
    done
}

# ensure_claude_dir HANDLE DIR — the person's config directory DIR (owned by them, 700), laid out
ensure_claude_dir() {
    local user="ws-$1" home="$HOMES/ws-$1" dir=$2
    valid_claude_dir "$dir"
    sudo -u "$user" env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        bash -c "set -eu; $(declare -f claude_dir_layout); cd /; claude_dir_layout \"\$@\"" claude_dir_layout "$home" "$dir" >&2 \
        || fail "could not prepare $home/$dir"
}

# claude_dir_remove HOME DIR — as the person: rm -rf takes the links in DIR away, never what they
# point to (the shared transcripts and settings in .claude stay). Never .claude itself.
claude_dir_remove() {
    local home=${1:?} dir=${2:?}
    [[ "$dir" =~ ^\.claude-[a-z0-9]{1,40}$ ]] || return 1
    rm -rf -- "${home:?}/${dir:?}"
}

# Claude Code policy for every workspace on this server, read as the workspace user (umask 027
# would leave it to root alone). No forceLoginMethod: it would refuse the API key a person may
# choose (ANTHROPIC_API_KEY "cannot be checked against that policy"); a build of 1.1 set it, so
# it is taken out here. The subscription sign-in is the person's own `claude auth login` anyway.
# The agents read nobody's Claude login: not .claude, not the other subscriptions' .claude-<slug>
# (a policy an older build wrote gets that rule once).
ensure_claude_policy() {
    local f=${CLAUDE_POLICY:?} rule='Read(/home/*/.claude-*/**)'
    mkdir -p "$(dirname "$f")"; chmod 755 "$(dirname "$f")"
    [ -f "$f" ] || cat > "$f" <<'JSON'
{
  "permissions": {
    "deny": ["Read(/etc/studio/**)", "Read(/home/*/.claude/**)", "Read(/home/*/.claude-*/**)", "Read(/srv/studio/projects/**)"],
    "disableBypassPermissionsMode": "disable"
  },
  "enableAllProjectMcpServers": true
}
JSON
    if jq -e 'has("forceLoginMethod")' "$f" >/dev/null 2>&1; then
        jq 'del(.forceLoginMethod)' "$f" > "$f.new" && mv -f "$f.new" "$f"
    fi
    if jq -e . "$f" >/dev/null 2>&1 && ! jq -e --arg r "$rule" '(.permissions.deny // []) | index($r) != null' "$f" >/dev/null 2>&1; then
        jq --arg r "$rule" '.permissions.deny = ((.permissions.deny // []) + [$r])' "$f" > "$f.new" && mv -f "$f.new" "$f"
    fi
    chmod 644 "$f"
}

# claude_as HANDLE DIR ARGS… — the person's own Claude Code in their home, with nothing of
# Studio's in the environment (no token: the login is the one in ~/DIR).
claude_as() {
    local user="ws-$1" home="$HOMES/ws-$1" dir=$2; shift 2
    valid_claude_dir "$dir"
    cd /
    sudo -u "$user" env -i HOME="$home" USER="$user" LOGNAME="$user" \
        PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        CLAUDE_CONFIG_DIR="$home/$dir" DISABLE_AUTOUPDATER=1 LANG=C.UTF-8 TERM=xterm-256color \
        bash -c 'cd "$HOME" && exec "$@"' claude "$@"
}

cmd_person_ensure() {
    valid_name "$1"; ensure_person "$1"
    echo '{"ok":true}'
}

cmd_claude_status() { # handle [dir]
    local handle=$1 dir=${2:-.claude}
    valid_name "$handle"; valid_claude_dir "$dir"; ensure_person "$handle"; ensure_claude_dir "$handle" "$dir"
    local out rc=0
    out=$(claude_as "$handle" "$dir" claude auth status 2>/dev/null) || rc=$?
    printf '%s' "$out" | jq -e . >/dev/null 2>&1 || out='null'
    jq -n --argjson s "$out" --argjson rc "$rc" \
        '{ok: true, logged_in: ($rc == 0), auth_method: ($s.authMethod? // null), status: $s}'
}

cmd_claude_logout() { # handle [dir]
    local handle=$1 dir=${2:-.claude}
    valid_name "$handle"; valid_claude_dir "$dir"; ensure_person "$handle"; ensure_claude_dir "$handle" "$dir"
    claude_as "$handle" "$dir" claude auth logout >/dev/null 2>&1 || true
    echo '{"ok":true}'
}

# claude-forget: a subscription the person removed from Studio. Signed out first (the CLI tells
# claude.ai), then its directory goes; the transcripts and settings it shared stay in .claude.
cmd_claude_forget() { # handle dir
    local handle=$1 dir=$2 user="ws-$1" home="$HOMES/ws-$1"
    valid_name "$handle"; valid_claude_dir "$dir"
    [ "$dir" != .claude ] || fail "the first Claude directory (.claude) is never removed: sign out instead"
    if id "$user" >/dev/null 2>&1 && { [ -e "$home/$dir" ] || [ -L "$home/$dir" ]; }; then
        if [ -d "$home/$dir" ] && [ ! -L "$home/$dir" ]; then
            claude_as "$handle" "$dir" claude auth logout >/dev/null 2>&1 || true
        fi
        sudo -u "$user" env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
            bash -c "set -eu; $(declare -f claude_dir_remove); cd /; claude_dir_remove \"\$@\"" claude_dir_remove "$home" "$dir" >&2 \
            || fail "could not remove $home/$dir"
    fi
    echo '{"ok":true}'
}

cmd_claude_login() { # handle cols rows [dir]
    local handle=$1 cols=$2 rows=$3 dir=${4:-.claude}
    valid_name "$handle"; valid_claude_dir "$dir"
    [[ "$cols" =~ ^[0-9]{2,3}$ ]] && [[ "$rows" =~ ^[0-9]{1,3}$ ]] || fail "invalid terminal size"
    ensure_person "$handle"; ensure_claude_dir "$handle" "$dir"
    trap - EXIT
    # script(1) gives the CLI a real terminal; stdin and stdout stay pipes to the gateway
    exec 3>&-
    claude_as "$handle" "$dir" script -qfec "stty cols $cols rows $rows 2>/dev/null; exec claude auth login" /dev/null
}

# git-cli: the agents' command-line tool for the forge of a person's git account, when it is not
# the installation's own (the system step installs that one). ensure_git_cli of the live release's
# installer/lib/system.sh does it; what it says goes to stderr, the answer stays alone on stdout.
cmd_git_cli() { # provider
    local provider=$1 lib="${STUDIO_DIR:-/opt/studio/current}/installer/lib/system.sh"
    [[ "$provider" =~ ^(github|gitlab|bitbucket|azure)$ ]] || fail "usage: git-cli github|gitlab|bitbucket|azure"
    [ -f "$lib" ] || fail "the system library of this release is missing ($lib)"
    # shellcheck disable=SC1090
    ( . "$lib"; declare -F ensure_git_cli >/dev/null || exit 3; ensure_git_cli "$provider" ) >&2 \
        || fail "the $provider command-line tool could not be installed (see ${STUDIO_APT_LOG:-/var/log/studio-install.log})"
    echo '{"ok":true}'
}

workspace_paths() { # handle slug
    W_SANDBOXES="$WORKSPACES/$1/.sandboxes/$2"
    W_USER="ws-$1"; W_HOME="$HOMES/ws-$1"; W_DIR="$WORKSPACES/$1/$2"; W_ENV="$ETC/workspaces/$1--$2.env"
    W_POOL="studio-ws-$1--$2"; W_SITE="/etc/caddy/sites/ws-$1--$2.caddy"; W_UNIT="studio-bridge-$1--$2"; W_BASE="studio-ws-$1--$2"; W_DB="ws_$(dbname "$1")_$(dbname "$2")"
}

write_workspace_env() { # after workspace_paths; reads tokens from INPUT, keeps existing values when a field is absent
    local bridge_token bridge_port claude_api_key var value
    bridge_token=$(field bridge_token); bridge_port=$(field bridge_port)
    claude_api_key=$(field claude_api_key)
    touch "$W_ENV"; chown "root:$W_USER" "$W_ENV"; chmod 640 "$W_ENV"
    set_env "$W_ENV" HOME "$W_HOME"
    set_env "$W_ENV" WORKSPACE_DIR "$W_DIR"
    set_env "$W_ENV" CLAUDE_CONFIG_DIR "$W_HOME/.claude"
    set_env "$W_ENV" CLAUDE_CODE_ENTRYPOINT studio
    set_env "$W_ENV" DISABLE_AUTOUPDATER 1
    # git in the workspace (the agent's pushes, the Changes tab's fetch) answers with the person's token
    set_env "$W_ENV" GIT_ASKPASS "$ASKPASS"
    set_env "$W_ENV" GIT_TERMINAL_PROMPT 0
    [ -n "$bridge_token" ] && set_env "$W_ENV" BRIDGE_TOKEN "$bridge_token"
    [ -n "$bridge_port" ] && set_env "$W_ENV" BRIDGE_PORT "$bridge_port"
    # the project timezone, for Claude and the terminal; the bridge picks it up when it starts
    if has_field timezone; then
        local tz; tz=$(project_timezone); set_env "$W_ENV" TZ "$tz"
    fi
    # git_token sent: one provider at a time, drop every agent variable, then set what Studio
    # sent; sent empty (the person removed their token) the workspace loses it at once.
    if has_field git_token; then
        unset_env "$W_ENV" GIT_TOKEN GIT_USERNAME "${GIT_AGENT_VARS[@]}"
        if [ -n "$(field git_token)" ]; then
            write_git_env "$W_ENV"
            for var in "${GIT_AGENT_VARS[@]}"; do
                value=$(printf '%s' "$INPUT" | jq -r --arg k "$var" '(.git_env // {})[$k] // empty')
                [ -n "$value" ] && set_env "$W_ENV" "$var" "$value"
            done
        fi
    fi
    workspace_agent_env
    # Claude: a subscription is the person's own login in ~/.claude (claude-login), never a
    # token here. An API key is kept apart from Claude Code's own variable: the bridge hands it
    # over as ANTHROPIC_API_KEY only to the conversations that run on it.
    sed -i '/^CLAUDE_CODE_OAUTH_TOKEN=/d; /^ANTHROPIC_API_KEY=/d' "$W_ENV"
    # Studio sends the field empty since a key goes with each turn instead: an `if`, not `[ … ] &&`,
    # or the empty test would be the function's last status and set -e would stop the caller.
    if has_field claude_api_key; then
        unset_env "$W_ENV" STUDIO_ANTHROPIC_API_KEY
        if [ -n "$claude_api_key" ]; then set_env "$W_ENV" STUDIO_ANTHROPIC_API_KEY "$claude_api_key"; fi
    fi
}

# workspace_agent_env — after workspace_paths: where the bridge puts sandboxes, and the agents'
# browser when this server has it (Playwright MCP and its Chromium, from the system step); its
# sandbox off only where AppArmor could not be given a profile for it (the .no-sandbox marker).
workspace_agent_env() {
    set_env "$W_ENV" BRIDGE_SANDBOX_ROOT "$W_SANDBOXES"
    local mcp; mcp=$(command -v playwright-mcp 2>/dev/null || true)
    if [ -n "$mcp" ] && [ -d "$BROWSERS" ]; then
        set_env "$W_ENV" BRIDGE_BROWSER_MCP "$mcp"
        set_env "$W_ENV" PLAYWRIGHT_BROWSERS_PATH "$BROWSERS"
        if [ -f "$BROWSERS/.no-sandbox" ]; then set_env "$W_ENV" BRIDGE_BROWSER_NO_SANDBOX 1; else unset_env "$W_ENV" BRIDGE_BROWSER_NO_SANDBOX; fi
    else
        unset_env "$W_ENV" BRIDGE_BROWSER_MCP PLAYWRIGHT_BROWSERS_PATH BRIDGE_BROWSER_NO_SANDBOX
    fi
}

cmd_workspace_create() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    local repo branch php engine host port name email
    repo=$(require_field repo_url); branch=$(require_field branch); php=$(require_field php_version); engine=$(require_field db_engine)
    host=$(require_field preview_host); port=$(require_field bridge_port); name=$(field git_name); email=$(field git_email)
    valid_php "$php"; valid_engine "$engine"; valid_branch "$branch"; valid_host "$host"; [[ "$port" =~ ^[0-9]{4,5}$ ]] || fail "invalid bridge port"
    [ -n "$(field git_token)" ] || fail "a git provider token is required to clone the repository"

    ensure_person "$handle"
    mkdir -p "$WORKSPACES/$handle"
    chown "$W_USER:$W_USER" "$WORKSPACES/$handle"; chmod 751 "$WORKSPACES/$handle"

    write_workspace_env

    if [ ! -d "$W_DIR/.git" ]; then
        log "cloning $repo @ $branch for $handle"
        clone_repo "$W_USER" "$WORKSPACES/$handle" "$W_ENV" "$repo" "$branch" "$W_DIR"
    fi
    chmod 751 "$W_DIR"
    [ -n "$name" ] && run_as "$W_USER" "$W_DIR" "$W_ENV" git config user.name "$name"
    [ -n "$email" ] && run_as "$W_USER" "$W_DIR" "$W_ENV" git config user.email "$email"

    local dbpass; dbpass=$(openssl rand -hex 16)
    db_create "$engine" "$W_DB" "$dbpass"
    local seeded=0
    if db_clone "$engine" "prj_$(dbname "$slug")" "$W_DB" 2>/dev/null; then seeded=1; log "database seeded from the project site"; fi
    write_env "$W_DIR" "https://$host" local true "$engine" "$W_DB" "$dbpass" "ws_${handle}_${slug}_"
    apply_preview_env "$W_DIR" "$(preview_env)"
    set_env "$W_DIR/.env" SESSION_COOKIE "ws_${handle}_${slug}_session"
    chown "$W_USER:$W_USER" "$W_DIR/.env"; chmod 600 "$W_DIR/.env"

    build "$W_USER" "$W_DIR" "$W_ENV" "$php" 1
    grant_web "$W_DIR"
    [ "$seeded" = 1 ] || run_as "$W_USER" "$W_DIR" "$W_ENV" "php$php" artisan migrate --force --quiet || log "migrate failed"
    run_as "$W_USER" "$W_DIR" "$W_ENV" "php$php" artisan larapilot:custom-skill-list >/dev/null 2>&1 || true

    render "$TPL/fpm-pool.conf.tpl" "/etc/php/$php/fpm/pool.d/$W_POOL.conf" NAME="$W_POOL" USER="$W_USER" GROUP="$W_USER" MAX=4 LOG="$W_HOME/php-$slug.log"
    reload_fpm "$php"
    render_site "$W_SITE" "ws_$(dbname "$handle")_$(dbname "$slug")" "$host" "$W_DIR" "$W_POOL" "$(preview_env)" "$(reverb_port_if_on)"
    apply_services "$W_BASE" "$W_USER" "$W_DIR" "$php" "$W_HOME" "$host"
    render "$TPL/bridge.service.tpl" "/etc/systemd/system/$W_UNIT.service" HANDLE="$handle" SLUG="$slug" USER="$W_USER" WORKSPACE_DIR="$W_DIR" ENV_FILE="$W_ENV" STUDIO_DIR="$STUDIO_DIR"
    systemctl daemon-reload
    systemctl enable --now "$W_UNIT" >/dev/null
    systemctl restart "$W_UNIT"

    jq -n --arg u "https://$host" --arg b "http://127.0.0.1:$port" --arg p "$W_DIR" '{ok:true, app_url:$u, bridge_url:$b, path:$p}'
}

# git_identity — git_name and git_email from the input, checked when sent: one line, 255 characters
# at most, and an address with a single @; into GIT_ID_NAME and GIT_ID_EMAIL
git_identity() {
    GIT_ID_NAME=$(field git_name); GIT_ID_EMAIL=$(field git_email)
    if [ -n "$GIT_ID_NAME" ]; then
        [ "${#GIT_ID_NAME}" -le 255 ] && [[ "$GIT_ID_NAME" != *[[:cntrl:]]* ]] || fail "invalid git name"
    fi
    if [ -n "$GIT_ID_EMAIL" ]; then
        [ "${#GIT_ID_EMAIL}" -le 255 ] && [[ "$GIT_ID_EMAIL" =~ ^[^[:space:][:cntrl:]@\<\>]+@[^[:space:][:cntrl:]@\<\>]+$ ]] || fail "invalid git email"
    fi
    return 0
}

# apply_git_identity — after workspace_paths and git_identity: the repository's own user.name and
# user.email in the workspace, as its user (the sandboxes are worktrees: they share this config).
# A field not sent leaves its value; sent empty, it is unset (the person's global one applies).
apply_git_identity() {
    [ -d "$W_DIR/.git" ] || return 0
    local key value
    for key in name email; do
        has_field "git_$key" || continue
        if [ "$key" = name ]; then value=$GIT_ID_NAME; else value=$GIT_ID_EMAIL; fi
        if [ -n "$value" ]; then
            run_as "$W_USER" "$W_DIR" "$W_ENV" git config user."$key" "$value" || fail "could not set git user.$key in $W_DIR"
        else
            run_as "$W_USER" "$W_DIR" "$W_ENV" git config --unset user."$key" >/dev/null 2>&1 || true
        fi
    done
}

cmd_workspace_env() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    [ -f "$W_ENV" ] || fail "workspace $handle/$slug does not exist"
    git_identity
    write_workspace_env
    apply_git_identity
    systemctl try-restart "$W_UNIT" >/dev/null 2>&1 || true
    echo '{"ok":true}'
}

cmd_workspace_start() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    [ -f "/etc/systemd/system/$W_UNIT.service" ] || fail "workspace $handle/$slug does not exist"
    if [ -f "$W_SITE" ]; then reload_caddy; else render_site "$W_SITE" "ws_$(dbname "$handle")_$(dbname "$slug")" "$(grep -E '^APP_URL=' "$W_DIR/.env" | cut -d= -f2- | sed 's#https://##')" "$W_DIR" "$W_POOL" "$(preview_env)" "$(reverb_port_if_on)"; fi
    [ -f "$W_ENV" ] && workspace_agent_env
    systemctl start "$W_UNIT"
    restart_services "$W_BASE"
    echo '{"ok":true,"status":"running"}'
}

cmd_workspace_stop() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    systemctl stop "$W_UNIT" >/dev/null 2>&1 || true
    stop_services "$W_BASE"
    pkill -u "$W_USER" -f "$W_DIR" 2>/dev/null || true
    echo '{"ok":true,"status":"stopped"}'
}

cmd_workspace_status() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    [ -d "$W_DIR/.git" ] || { echo '{"ok":true,"status":"missing"}'; return; }
    if systemctl is-active --quiet "$W_UNIT"; then echo '{"ok":true,"status":"running"}'; else echo '{"ok":true,"status":"stopped"}'; fi
}

cmd_workspace_configure() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    [ -d "$W_DIR/.git" ] || fail "workspace $handle/$slug does not exist"
    local php host; php=$(require_field php_version); host=$(require_field preview_host); valid_php "$php"; valid_host "$host"
    local env; env=$(preview_env)
    render_site "$W_SITE" "ws_$(dbname "$handle")_$(dbname "$slug")" "$host" "$W_DIR" "$W_POOL" "$env" "$(reverb_port_if_on)"
    # the previews may have moved to another domain: the app's URL follows; public or not, its environment too
    set_env "$W_DIR/.env" APP_URL "https://$host"
    apply_preview_env "$W_DIR" "$env"
    preview_env_of_sandboxes "$handle" "$slug" "$env"
    apply_services "$W_BASE" "$W_USER" "$W_DIR" "$php" "$W_HOME" "$host"
    # Claude and the terminal: from the next start of the workspace, a running chat is not cut off
    local tz; tz=$(project_timezone); [ -f "$W_ENV" ] && set_env "$W_ENV" TZ "$tz"
    echo '{"ok":true}'
}

cmd_workspace_delete() {
    local handle=$1 slug=$2; valid_name "$handle"; valid_name "$slug"; workspace_paths "$handle" "$slug"
    systemctl disable --now "$W_UNIT" >/dev/null 2>&1 || true
    remove_services "$W_BASE"
    rm -f "/etc/systemd/system/$W_UNIT.service" "$W_SITE"
    # its sandboxes: their preview hosts, databases and worktrees
    local sb id
    for sb in "$W_SANDBOXES"/c*; do
        [ -d "$sb" ] || continue
        id=${sb##*/c}; [[ "$id" =~ ^[0-9]+$ ]] || continue
        sandbox_paths "$handle" "$slug" "$id"
        rm -f "$S_SITE"; db_drop mariadb "$S_DB"; db_drop pgsql "$S_DB"
    done
    rm -f /etc/caddy/sites/"ws-$handle--$slug--c"*.caddy
    rm -rf "${W_SANDBOXES:?}"
    rm -f /etc/php/*/fpm/pool.d/"$W_POOL".conf
    systemctl daemon-reload; reload_caddy
    reload_all_fpm
    db_drop mariadb "$W_DB"; db_drop pgsql "$W_DB"
    # ${VAR:?} makes bash stop here instead of removing a top-level path if a variable were ever empty.
    rm -rf "${WORKSPACES:?}/${handle:?}/${slug:?}" "${W_ENV:?}"
    # the Linux user stays while it owns other workspaces
    if [ -z "$(ls -A "$WORKSPACES/$handle" 2>/dev/null)" ]; then
        pkill -u "$W_USER" 2>/dev/null || true
        userdel -r "$W_USER" 2>/dev/null || true
        rm -rf "${WORKSPACES:?}/${handle:?}"
    fi
    echo '{"ok":true}'
}

# -------------------------------------------------------------- sandboxes --
# A sandbox is one conversation's own copy of a workspace: the bridge makes the git worktree
# (…/.sandboxes/<slug>/c<id>, on its own branch of the same repository); this gives it what
# makes it an app: its .env, a copy of the workspace's database, the build, and a preview host
# served by the workspace's own PHP pool. Queues run inline there, no scheduler, no Reverb:
# one conversation's app, not a site.

sandbox_paths() { # handle slug id — after or without workspace_paths
    S_DIR="$WORKSPACES/$1/.sandboxes/$2/c$3"; S_SITE="/etc/caddy/sites/ws-$1--$2--c$3.caddy"
    S_DB=$(printf 'sb_%s_%s_%s' "$3" "$(dbname "$1")" "$(dbname "$2")" | cut -c1-60); S_MATCHER="sb_$3_$(dbname "$1")_$(dbname "$2")"
}

cmd_sandbox_create() {
    local handle=$1 slug=$2 id=$3; valid_name "$handle"; valid_name "$slug"; [[ "$id" =~ ^[0-9]{1,12}$ ]] || fail "invalid sandbox id"
    workspace_paths "$handle" "$slug"; sandbox_paths "$handle" "$slug" "$id"
    local php engine host branch; php=$(require_field php_version); engine=$(require_field db_engine); host=$(require_field preview_host); branch=$(require_field branch)
    valid_php "$php"; valid_engine "$engine"; valid_branch "$branch"
    valid_host "$host"
    [ -f "$S_DIR/.git" ] || fail "sandbox c$id of $handle/$slug has no worktree: the bridge creates it first"
    [ "$(stat -c %U "$S_DIR")" = "$W_USER" ] || fail "sandbox c$id is not owned by $W_USER"

    # Caddy and PHP get through to it like to the workspace
    chmod 751 "$WORKSPACES/$handle/.sandboxes" "$W_SANDBOXES" "$S_DIR"

    local dbpass; dbpass=$(openssl rand -hex 16)
    db_create "$engine" "$S_DB" "$dbpass"
    local seeded=0
    if db_clone "$engine" "$W_DB" "$S_DB" 2>/dev/null; then seeded=1; log "sandbox database copied from the workspace"; fi
    [ -f "$W_DIR/.env" ] && [ ! -f "$S_DIR/.env" ] && install -o "$W_USER" -g "$W_USER" -m 600 "$W_DIR/.env" "$S_DIR/.env"
    write_env "$S_DIR" "https://$host" local true "$engine" "$S_DB" "$dbpass" "sb_${id}_${handle}_${slug}_"
    apply_preview_env "$S_DIR" "$(preview_env)"
    set_env "$S_DIR/.env" SESSION_COOKIE "sb_${id}_${handle}_${slug}_session"
    set_env "$S_DIR/.env" QUEUE_CONNECTION sync
    set_env "$S_DIR/.env" BROADCAST_CONNECTION log
    set_env "$S_DIR/.env" APP_TIMEZONE "$(project_timezone)"
    chown "$W_USER:$W_USER" "$S_DIR/.env"; chmod 600 "$S_DIR/.env"

    build "$W_USER" "$S_DIR" "$W_ENV" "$php" 1
    grant_web "$S_DIR"
    [ "$seeded" = 1 ] || run_as "$W_USER" "$S_DIR" "$W_ENV" "php$php" artisan migrate --force --quiet || log "migrate failed"
    # the pool exists while the workspace does; the host reloads Caddy, or puts the old file back
    render_site "$S_SITE" "$S_MATCHER" "$host" "$S_DIR" "$W_POOL" "$(preview_env)" ""

    jq -n --arg u "https://$host" --arg p "$S_DIR" --arg d "$S_DB" '{ok:true, app_url:$u, path:$p, database:$d}'
}

# preview_env_of_sandboxes HANDLE SLUG ENV — the sandboxes of a workspace follow it, public or not: their
# .env, and the APP_ENV line of their host's file (Studio's own file, never rendered again from a value
# the workspace could have written)
preview_env_of_sandboxes() {
    local sb id changed=0
    for sb in "$W_SANDBOXES"/c*; do
        id=${sb##*/c}; [[ "$id" =~ ^[0-9]+$ ]] || continue
        sandbox_paths "$1" "$2" "$id"
        [ -f "$S_SITE" ] && [ -f "$S_DIR/.env" ] && [ ! -L "$S_DIR/.env" ] || continue
        apply_preview_env "$S_DIR" "$3"
        sed -i "s|^\( *env APP_ENV \).*|\1$3|" "$S_SITE"
        changed=1
    done
    [ "$changed" = 0 ] || reload_caddy
}

cmd_sandbox_delete() {
    local handle=$1 slug=$2 id=$3; valid_name "$handle"; valid_name "$slug"; [[ "$id" =~ ^[0-9]{1,12}$ ]] || fail "invalid sandbox id"
    workspace_paths "$handle" "$slug"; sandbox_paths "$handle" "$slug" "$id"
    rm -f "$S_SITE"; reload_caddy
    db_drop mariadb "$S_DB"; db_drop pgsql "$S_DB"
    # the bridge removes the worktree while the workspace runs; here when it did not
    if [ -e "$S_DIR" ]; then
        local branch=""
        [ -f "$S_DIR/.git" ] && branch=$(run_as "$W_USER" "$S_DIR" "" git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
        pkill -u "$W_USER" -f "$S_DIR" 2>/dev/null || true
        rm -rf "${S_DIR:?}"
        [ -d "$W_DIR/.git" ] && run_as "$W_USER" "$W_DIR" "" git worktree prune || true
        if [ "$(field delete_branch)" = 1 ] && [ -n "$branch" ] && [ "$branch" != HEAD ] && [ -d "$W_DIR/.git" ]; then
            run_as "$W_USER" "$W_DIR" "" git branch -D "$branch" >/dev/null 2>&1 || true
        fi
    fi
    echo '{"ok":true}'
}

# ------------------------------------------------------------------ updates --
# Administration → System: Studio reads /var/lib/studio-update/state.json itself;
# these start what needs root. The update runs as its own systemd unit, so it
# survives the restart of the queue worker that asked for it.

cmd_update_check() {
    /usr/local/sbin/studio-update check || fail "could not reach the Studio repository"
}

# an update of Studio and an update of the server never run together
update_running() {
    local u
    for u in studio-update.service studio-update-force.service studio-update-auto.service studio-system-update.service studio-system-update-auto.service; do
        systemctl is-active --quiet "$u" && return 0
    done
    return 1
}

cmd_update_start() { # [force] — force builds and installs the channel's newest build even when it is installed
    local unit=studio-update.service
    [ "${1:-}" = force ] && unit=studio-update-force.service
    update_running && fail "an update is already running"
    systemctl start --no-block "$unit" || fail "could not start $unit"
    jq -n --arg u "$unit" '{ok:true, started:true, unit:$u}'
}

cmd_update_channel() {
    [[ "$1" =~ ^(stable|beta)$ ]] || fail "usage: update-channel stable|beta"
    /usr/local/sbin/studio-update channel "$1" || fail "could not change the update channel"
}

cmd_update_auto() {
    [[ "$1" =~ ^(on|off)$ ]] || fail "usage: update-auto on|off"
    /usr/local/sbin/studio-update auto "$1" || fail "could not change automatic updates"
}

cmd_system_update_start() { # every package on the server to its newest version, as its own unit
    update_running && fail "an update is already running"
    systemctl start --no-block studio-system-update.service || fail "could not start studio-system-update.service"
    jq -n '{ok:true, started:true, unit:"studio-system-update.service"}'
}

cmd_system_update_auto() {
    [[ "$1" =~ ^(on|off)$ ]] || fail "usage: system-update-auto on|off"
    /usr/local/sbin/studio-update system-auto "$1" || fail "could not change the nightly server update"
}

# ---------------------------------------------------------------- dispatch --

cmd=${1:-}; shift || true
case "$cmd" in
    project-bootstrap) [ $# -eq 1 ] || fail "usage: project-bootstrap <slug>"; cmd_project_bootstrap "$1" ;;
    project-create)   [ $# -eq 1 ] || fail "usage: project-create <slug>";   cmd_project_create "$1" ;;
    project-deploy)   [ $# -eq 1 ] || fail "usage: project-deploy <slug>";   cmd_project_deploy "$1" ;;
    project-delete)   [ $# -eq 1 ] || fail "usage: project-delete <slug>";   cmd_project_delete "$1" ;;
    project-configure) [ $# -eq 1 ] || fail "usage: project-configure <slug>"; cmd_project_configure "$1" ;;
    workspace-create) [ $# -eq 2 ] || fail "usage: workspace-create <handle> <slug>"; cmd_workspace_create "$1" "$2" ;;
    workspace-env)    [ $# -eq 2 ] || fail "usage: workspace-env <handle> <slug>";    cmd_workspace_env "$1" "$2" ;;
    workspace-start)  [ $# -eq 2 ] || fail "usage";  cmd_workspace_start "$1" "$2" ;;
    workspace-stop)   [ $# -eq 2 ] || fail "usage";  cmd_workspace_stop "$1" "$2" ;;
    workspace-status) [ $# -eq 2 ] || fail "usage";  cmd_workspace_status "$1" "$2" ;;
    workspace-delete) [ $# -eq 2 ] || fail "usage";  cmd_workspace_delete "$1" "$2" ;;
    workspace-configure) [ $# -eq 2 ] || fail "usage: workspace-configure <handle> <slug>"; cmd_workspace_configure "$1" "$2" ;;
    sandbox-create)   [ $# -eq 3 ] || fail "usage: sandbox-create <handle> <slug> <id>"; cmd_sandbox_create "$1" "$2" "$3" ;;
    sandbox-delete)   [ $# -eq 3 ] || fail "usage: sandbox-delete <handle> <slug> <id>"; cmd_sandbox_delete "$1" "$2" "$3" ;;
    person-ensure)    [ $# -eq 1 ] || fail "usage: person-ensure <handle>"; cmd_person_ensure "$1" ;;
    claude-status)    [ $# -eq 1 ] || [ $# -eq 2 ] || fail "usage: claude-status <handle> [dir]"; cmd_claude_status "$1" "${2:-.claude}" ;;
    claude-logout)    [ $# -eq 1 ] || [ $# -eq 2 ] || fail "usage: claude-logout <handle> [dir]"; cmd_claude_logout "$1" "${2:-.claude}" ;;
    claude-forget)    [ $# -eq 2 ] || fail "usage: claude-forget <handle> <dir>"; cmd_claude_forget "$1" "$2" ;;
    claude-login)     [ $# -eq 3 ] || [ $# -eq 4 ] || fail "usage: claude-login <handle> <cols> <rows> [dir]"; cmd_claude_login "$1" "$2" "$3" "${4:-.claude}" ;;
    git-cli)          [ $# -eq 1 ] || fail "usage: git-cli <provider>"; cmd_git_cli "$1" ;;
    update-check)     cmd_update_check ;;
    update-start)     [ $# -le 1 ] && [[ "${1:-}" =~ ^(force)?$ ]] || fail "usage: update-start [force]"; cmd_update_start "${1:-}" ;;
    update-channel)   [ $# -eq 1 ] || fail "usage: update-channel stable|beta"; cmd_update_channel "$1" ;;
    update-auto)      [ $# -eq 1 ] || fail "usage: update-auto on|off"; cmd_update_auto "$1" ;;
    system-update-start) [ $# -eq 0 ] || fail "usage: system-update-start"; cmd_system_update_start ;;
    system-update-auto)  [ $# -eq 1 ] || fail "usage: system-update-auto on|off"; cmd_system_update_auto "$1" ;;
    *) fail "unknown command: ${cmd:-none}" ;;
esac
