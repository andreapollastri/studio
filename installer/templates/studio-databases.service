[Unit]
Description=Studio databases worker
After=network.target mariadb.service

[Service]
Type=simple
User=studio
Group=studio
WorkingDirectory=__STUDIO_DIR__
# Tools → Databases: imports and exports, one at a time, hours allowed for each
ExecStart=/usr/bin/__PHP__ artisan queue:work databases --queue=databases --sleep=5 --tries=1 --timeout=21600 --max-time=86400
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
