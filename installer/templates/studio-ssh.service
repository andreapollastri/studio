[Unit]
Description=Studio SSH gateway (the SSH terminal page and the sign-in to Claude Code)
After=network.target

[Service]
Type=simple
User=studio
Group=studio
WorkingDirectory=__STUDIO_DIR__/ssh-gateway
# APP_KEY and APP_URL come from Studio's own .env: the gateway's token is derived from APP_KEY.
EnvironmentFile=__STUDIO_HOME__/shared/.env
Environment=SSH_GATEWAY_HOST=127.0.0.1
Environment=SSH_GATEWAY_PORT=8082
Environment=SSH_GATEWAY_REDEEM_URL=http://127.0.0.1:8081/api/ssh/redeem
ExecStart=/usr/bin/node __STUDIO_DIR__/ssh-gateway/bin/gateway.js
Restart=always
RestartSec=3
# No NoNewPrivileges / ProtectSystem / ProtectHome here: the sign-in to Claude Code runs
# `sudo studio-admin claude-login <handle>`, which needs sudo and writes the person's home.
# The gateway runs as studio, the same user that already may run the helper.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
