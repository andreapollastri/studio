# What this release of Studio needs on the server. The installer and the
# updater (studio-update) read it and install whatever is missing, so a new
# release can bring a new PHP or Node with it. Plain KEY=VALUE, sourced by bash.

# PHP that runs Studio itself, and the one new projects start on
STUDIO_PHP=8.5
# PHP versions every server gets, for project sites and workspaces (space separated)
PHP_VERSIONS="8.5"
# PHP versions an administrator may add from Administration → System (studio-admin
# php-install); once installed, every update looks after them like the others
PHP_OPTIONAL="8.3 8.4"
# The first patch of each PHP branch with the security fixes this release asks for; an
# installed PHP before it is upgraded on the next update (21 Oct 2026: CVE-2026-109618
# and CVE-2026-109619, remote code execution)
PHP_FIXED="8.2.35 8.3.36 8.4.27 8.5.12"
# Node.js major version (the bridge, Claude Code, asset builds)
NODE_MAJOR=22
# Playwright MCP, the agents' browser (its Chromium comes with it); pinned: its flags are the bridge's
PLAYWRIGHT_MCP_VERSION=0.0.83
